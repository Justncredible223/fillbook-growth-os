# Fillbook Growth OS backend — copy to .env.local and fill in real values.
# Never commit .env.local. Secrets live only here locally / in Vercel's
# encrypted project env vars, never in the Android app.

SUPABASE_URL=https://aijnibayogdygtykidta.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# X (Signal Graph adapter — mentions/engagement for @FillbookHQ, Owned
# Reads pricing). Client ID/Secret come from the X Developer Console app's
# OAuth 2.0 Keys. Access/Refresh Token come from that same page's "Access
# Token > Generate" (scopes: tweet.read, users.read, offline.access only
# — no write scopes, no DM scopes). These only bootstrap the very first
# run; after that the adapter persists refreshed tokens to the
# platform_oauth_credentials table itself, since a serverless invocation
# can't write back to its own env vars.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# Google (Search Console + YouTube signals). Project "Fillbook Growth OS"
# in Google Cloud Console, Search Console API + YouTube Data API v3
# enabled. Must be authorized as whichever Google account actually owns
# the verified Search Console property and the YouTube channel -- not
# necessarily the account that owns the Cloud project. Scopes:
# webmasters.readonly, youtube.readonly. Same bootstrap-then-self-persist
# pattern as the X credentials above.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# TikTok (Signal Graph adapter -- organic video stats for @fillbookhq:
# views/likes/comments/shares only). Client Key/Secret come from the
# TikTok for Developers app's "Login Kit" credentials. Access/Refresh
# Token come from completing that app's OAuth consent flow once as
# @fillbookhq, requesting ONLY the user.info.basic and video.list scopes
# -- never video.publish or video.upload. Read-only by construction, and
# ExternalWriteFirewall rejects any tiktok.* write action unconditionally
# regardless of what scopes exist. Same bootstrap-then-self-persist
# pattern as the X/Google credentials above (TikTok also rotates the
# refresh token on every use, so the adapter re-saves both every refresh).
# Unrelated to TikTok Promote, which is separately account-blocked for
# @fillbookhq -- see docs/CLAUDE_HANDOFF.md in the fillbookhq project.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# AI provider key -- deep content-review agents (Phase 6: trader,
# hook_specialist, copy_editor, skeptic, brand_guardian, growth_strategist,
# fact_checker, integrity_reviewer, conversion_reviewer). Create a key at
# platform.claude.com/settings/keys. Console now issues identity-linked
# keys by default, which require the workspace they act in on every
# request -- find yours at platform.claude.com/settings/workspaces (the
# "ID" column loads async; if it stays blank, reload). Omitting
# ANTHROPIC_WORKSPACE_ID fails with "anthropic-workspace-id is required
# when authenticating with an identity-linked API key".
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Reddit (Reddit prospecting/inbound adapter -- read-only: subreddit search
# for discovery, /message/inbox for comment replies/username mentions/DMs
# to @fillbookhq). As of the Responsible Builder Policy (Reddit closed
# self-service OAuth app registration in late 2025), a NEW Reddit "script"
# app requires manual approval via Reddit's own Data API request form
# before it can call the API at all -- budget 2-4 weeks lead time. See
# docs/REDDIT_INTEGRATION.md for the full setup steps, required scopes
# (identity, read, history -- no write scopes), and the verified-vs-
# assumed split on Reddit's current API terms. Client ID/Secret come from
# the approved app's "personal use script" credentials page. Access/Refresh
# Token come from completing that app's OAuth consent flow once as the
# @fillbookhq Reddit account. Same bootstrap-then-self-persist pattern as
# the X/Google/TikTok credentials above.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ACCESS_TOKEN=
REDDIT_REFRESH_TOKEN=
# Required on every Reddit API request per Reddit's API rules -- a generic/
# default User-Agent is throttled or blocked. Format:
# "<platform>:<app id>:<version> (by /u/<your reddit username>)".
REDDIT_USER_AGENT=web:fillbook-growth-os:v1.0 (by /u/CHANGE_ME)

# Scheduling (backend/src/config/scheduleConfig.ts) -- the single source of
# truth for when X prospecting/inbound, Reddit prospecting, and Reddit
# inbound run, and what timezone their times are expressed in. All are
# optional; each falls back to the approved default schedule if unset.
# America/Phoenix never observes DST, so a fixed-UTC external scheduler
# (see .github/workflows/growth-pulse.yml) stays correct year-round without
# a seasonal adjustment -- changing this to a DST-observing zone would
# require also updating that workflow file's cron lines (see its own
# comment).
SCHEDULE_TIMEZONE=America/Phoenix
X_PROSPECTING_TIMES=08:00,13:00,18:00
X_INBOUND_TIMES=08:00,13:00,18:00
REDDIT_PROSPECTING_TIMES=09:00
REDDIT_INBOUND_TIMES=08:00,13:00,18:00

# Authorizes calls to /api/daily-pipeline and /api/growth-pulse, the
# scheduled entry points (see vercel.json and
# .github/workflows/growth-pulse.yml). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The SAME value must also be added as a GitHub Actions repo secret
# (Settings -> Secrets and variables -> Actions -> New repository secret)
# named CRON_SECRET, plus a second secret BACKEND_BASE_URL (this project's
# live Vercel URL, e.g. https://fillbook-growth-os.vercel.app) -- both are
# manual owner steps (see docs/PROGRESS_LEDGER.md), never something this
# codebase can set for itself.
CRON_SECRET=
