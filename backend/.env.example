# Fillbook Growth OS backend — copy to .env.local and fill in real values.
# Never commit .env.local. Secrets live only here locally / in Vercel's
# encrypted project env vars, never in the Android app.

SUPABASE_URL=https://aijnibayogdygtykidta.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# X (Signal Graph adapter — mentions/engagement for @FillbookHQ, Owned
# Reads pricing). Client ID/Secret come from the X Developer Console app's
# OAuth 2.0 Keys. Access/Refresh Token come from that same page's "Access
# Token > Generate" (scopes: tweet.read, users.read, offline.access only
# — no write scopes, no DM scopes). These only bootstrap the very first
# run; after that the adapter persists refreshed tokens to the
# platform_oauth_credentials table itself, since a serverless invocation
# can't write back to its own env vars.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# AI provider keys — populated per-workload in later phases (Phase 3+).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
